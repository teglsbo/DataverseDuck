# Copy to .env and fill in. .env is gitignored; this file is not.
# Never put the real secret in this file.
#
# All variables are prefixed DATAVERSE_ for grouping, but only the URL comes
# from Power Platform. The rest come from the Entra app registration.

# Power Platform Admin Center > Environments > your environment
DATAVERSE_URL=https://yourorg.crm4.dynamics.com

# Entra ID > App registrations > your app > Overview > Directory (tenant) ID.
# NOT the environment ID or organization ID shown in the admin centre.
DATAVERSE_TENANT_ID=00000000-0000-0000-0000-000000000000

# Same Overview page > Application (client) ID. A different GUID from the above.
DATAVERSE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# --- Credentials: set exactly one of the following three. -------------------
# Two configured at once is refused rather than resolved by precedence, so
# that a leftover secret cannot quietly win over a certificate you just
# switched to.

# Certificates & secrets > the Value column, not the Secret ID.
DATAVERSE_CLIENT_SECRET=

# Or a certificate. A .pfx holds the private key; the .cer you upload to the
# app registration does not, and authenticating needs the private half.
#DATAVERSE_CERT_PATH=/path/to/app.pfx
#DATAVERSE_CERT_PASSWORD=

# Or a certificate already in the platform store. On Linux that store is a
# per-user directory nothing populates by default, so prefer the file above.
#DATAVERSE_CERT_THUMBPRINT=

# Or sign in interactively as yourself instead of as the application -- the
# only mode where MFA can apply, since it is the only one with a user in the
# flow at all. No client ID is required either: leave DATAVERSE_CLIENT_ID
# unset and it defaults to Microsoft's well-known public sample app, already
# registered in every tenant. Prints a URL and a short code; open it on any
# device with a browser to finish signing in -- no browser is needed on the
# machine running dvduck itself, so this works the same over SSH or in a
# container. See docs/environment-setup.md#device-code-sign-in.
#DATAVERSE_AUTH_MODE=devicecode

# Optional, device-code only: which cached sign-in to reuse across runs when
# more than one account has signed in on this machine before.
#DATAVERSE_USERNAME=you@yourorg.onmicrosoft.com

# --- Profiles ---------------------------------------------------------------
# Prefix any variable above with a profile name to address a second
# environment, then select it with 'dvduck query --profile test'. Anything the
# profile does not set falls back to the unprefixed value, so environments
# sharing one app registration need only override the URL.

#DATAVERSE_TEST_URL=https://yourorg-test.crm4.dynamics.com

# Selects a profile when --profile is not passed.
#DATAVERSE_PROFILE=test
