<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>true</IsPackable>
    <PackageId>DataverseDuck</PackageId>
    <Description>
      Query Microsoft Dataverse tables and local JSON logs in a single SQL statement.
      Filters are pushed into Dataverse as FetchXML by SQL 4 CDS, and only the matching
      rows are streamed into DuckDB to join against JSON locally.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Shipped inside the package so a consumer's build fails loudly rather than
      their process dying at runtime. See the targets file for why.
    -->
    <None Include="build/DataverseDuck.targets"
          Pack="true"
          PackagePath="buildTransitive/DataverseDuck.targets" />
  </ItemGroup>

  <ItemGroup>
    <!-- The plan analyzer couples to internal engine type names; tests pin them. -->
    <InternalsVisibleTo Include="DataverseDuck.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DuckDB.NET.Data.Full" Version="1.5.5" />
    <PackageReference Include="MarkMpn.Sql4Cds.Engine" Version="10.4.4" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.79.0" />
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.79.0" />
    <!-- Already a transitive dependency of MarkMpn.Sql4Cds.Engine 10.4.4; pinned explicitly
         to the same version so KeySetPushdown's own parsing stays on the exact grammar SQL 4
         CDS itself compiles against. -->
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="170.64.0" />
  </ItemGroup>

</Project>
