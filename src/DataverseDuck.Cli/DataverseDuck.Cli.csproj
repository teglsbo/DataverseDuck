<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>dvduck</AssemblyName>
    <RootNamespace>DataverseDuck.Cli</RootNamespace>

    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dvduck</ToolCommandName>
    <PackageId>DataverseDuck.Cli</PackageId>
    <Description>
      Command line tool for querying Microsoft Dataverse alongside local JSON files.
      Install with: dotnet tool install --global DataverseDuck.Cli
    </Description>

    <!--
      Not invariant. SQL 4 CDS builds SQL Server collations in a static
      constructor, which needs real culture data; under InvariantGlobalization
      the whole engine fails to initialise with a TypeInitializationException
      that names none of this. Found on the first run against a real tenant;
      the tests never saw it because this property is only set here.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../DataverseDuck/DataverseDuck.csproj" />
  </ItemGroup>

</Project>
